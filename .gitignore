# Logs
logs
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Supabase local metadata
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
-e 
# Environment variables — never commit these
.env
.env.*
!.env.example

# Signing keys & secrets — never commit these (defense-in-depth; the
# android/ and gandd-mobile/ subfolders also ignore them locally)
*.jks
*.keystore
*.p8
*.p12
*.pem
keystore.properties
credentials.json

# Bulk library ingest resume state (scripts/ingest-library.mjs)
.library-ingest-state.json

# Vercel CLI project link + the .env.local it writes (OIDC token). The .env
# rules above already cover .env.local; `vercel link` also appends a broader
# `.env*` here, which would override the `!.env.example` negation above — do
# not re-add it.
.vercel
