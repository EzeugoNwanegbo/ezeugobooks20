# Copy this file to .env and fill in your values

# Supabase — find these in your Supabase project dashboard under Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# PostHog - find these in PostHog under Project settings > Project Variables
# Use https://us.i.posthog.com for US Cloud or https://eu.i.posthog.com for EU Cloud.
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-only Supabase Edge Function secrets:
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
