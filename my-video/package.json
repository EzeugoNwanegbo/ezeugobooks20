{
  "name": "my-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.473",
    "@remotion/google-fonts": "^4.0.473",
    "@remotion/tailwind-v4": "4.0.473",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.473",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.473",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render MarshalAd out/marshal.mp4",
    "render:bright": "node -e \"require('fs').rmSync('node_modules/.cache/webpack',{recursive:true,force:true})\" && remotion render GandDBrightAd out/gandd-bright.mp4",
    "render:alive": "remotion render TextbookAlive out/textbook-alive.mp4",
    "render:future": "remotion render GD1FutureTrailer out/gd1-future-trailer.mp4",
    "render:updates": "remotion render GD1ProductUpdate out/gd1-product-update.mp4",
    "render:launch": "remotion render GandDPremiumLaunch out/gandd-premium-launch.mp4",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
